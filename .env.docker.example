# =============================================================================
# AI-QA-Assistant Docker Environment Configuration Template
# Copy this file to .env: cp .env.docker.example .env (Linux/Mac) or copy .env.docker.example .env (Windows)
# =============================================================================

# LLM API Key (Required)
LLM_API_KEY=your_llm_api_key_here

# LLM API Endpoint and Model settings
LLM_API_BASE=https://api.longcat.chat/openai/v1
LLM_MODEL=LongCat-2.0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# Default retrieval mode: hybrid / vector / bm25
DEFAULT_RETRIEVAL_MODE=hybrid

# Agent internal shared token between Web and Agent layers
AGENT_API_KEY=qa_assistant_agent_secret_token_2026

# Web session secret key
SESSION_SECRET=qa_session_secret_key_long_random_string_2026
