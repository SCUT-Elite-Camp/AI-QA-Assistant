# =============================================================================
# AI-QA-Assistant Docker 部署环境变量配置模板
# 复制此文件为 .env 即可生效：cp .env.docker.example .env (Linux/Mac) 或 copy .env.docker.example .env (Windows)
# =============================================================================

# 大模型 API 密钥 (必填)
LLM_API_KEY=your_llm_api_key_here

# 大模型 API 端点 (可选，默认使用 LongCat API)
LLM_API_BASE=https://api.longcat.chat/openai/v1
LLM_MODEL=LongCat-2.0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# 默认检索模式 (hybrid / vector / bm25)
DEFAULT_RETRIEVAL_MODE=hybrid

# Agent 内部服务通信 Token (前后端共享密钥)
AGENT_API_KEY=qa_assistant_agent_secret_token_2026

# Web 网站 Session 密钥 (建议设置为随机长字符串)
SESSION_SECRET=qa_session_secret_key_long_random_string_2026
