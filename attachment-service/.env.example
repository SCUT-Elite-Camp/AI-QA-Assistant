ATTACHMENT_INTERNAL_SECRET=replace-with-a-long-random-secret
ATTACHMENT_ENCRYPTION_KEY=replace-with-urlsafe-base64-encoded-32-bytes
ATTACHMENT_ENCRYPTION_KEY_ID=v1
ATTACHMENT_DATA_DIR=../data-persistence/data/attachments
# Keep model weights and all framework caches off the Windows system drive.
LOCAL_MODEL_ROOT=G:\AI-QA-Assistant\models
MODEL_CACHE_ROOT=G:\AI-QA-Assistant\cache
ATTACHMENT_SCANNER=auto
ALLOW_FAKE_ATTACHMENT_SCANNER=false
LOCAL_VISION_ENABLED=false
LOCAL_VISION_MODEL_PATH=G:\AI-QA-Assistant\models\qwen\Qwen3-VL-2B-Instruct
ATTACHMENT_OFFLINE_MODE=true
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PP_STRUCTURE_CONFIG_PATH=G:\AI-QA-Assistant\models\paddleocr\PP-StructureV3\pipeline.yaml
PADDLE_OCR_ENABLE_MKLDNN=false
LIBREOFFICE_PATH=
ATTACHMENT_VECTOR_INDEX_ENABLED=false
# Personal Library READY requires this to be true and uses the isolated
# ATTACHMENT_MILVUS_COLLECTION, never the enterprise collection.
PERSONAL_LIBRARY_ENABLED=true
ATTACHMENT_MILVUS_COLLECTION=attachment_evidence_cp2
