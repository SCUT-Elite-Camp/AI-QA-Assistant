# Confluence Cloud API 凭据模板
# 用法：复制本文件为同目录下的 .confluence.env，并填入你自己的值
# （.confluence.env 已被 .gitignore 忽略，不会进入版本库）

# Confluence 站点基址，形如 https://<你的域名>.atlassian.net/wiki
CONFLUENCE_BASE=https://your-domain.atlassian.net/wiki

# 你的 Atlassian 登录邮箱
CONFLUENCE_EMAIL=your_email@domain.com

# 在 https://id.atlassian.com/manage-profile/security/api-tokens 创建的 API Token
CONFLUENCE_TOKEN=your_api_token_here
