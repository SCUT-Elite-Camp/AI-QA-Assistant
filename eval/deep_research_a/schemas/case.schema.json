{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scut-elite-camp.local/schemas/deep-research-case.v1.json",
  "title": "CP2 Deep Research evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "category", "question", "source_manifest", "expected_behavior", "required_facts", "forbidden_claims", "key_source_locations", "allowed_document_ids", "forbidden_document_ids"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^DR-A-[0-9]{3}$"},
    "category": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 5},
    "source_manifest": {"type": "string", "pattern": "^manifest:DR-A-[0-9]{3}$"},
    "expected_behavior": {"enum": ["answer", "degraded", "refuse", "request_more_information", "conflict_review"]},
    "allowed_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
    "forbidden_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
    "required_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "description", "match_any"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "match_any": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "forbidden_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "match_any"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "match_any": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "key_source_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "chunk_id", "section", "quote"],
        "properties": {
          "doc_id": {"type": "string"},
          "chunk_id": {"type": "string"},
          "section": {"type": "string"},
          "quote": {"type": "string", "minLength": 3}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
