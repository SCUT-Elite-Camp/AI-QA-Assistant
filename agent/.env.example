DEFAULT_TOP_K=5
MIN_RETRIEVAL_SCORE=0.0
DEFAULT_RETRIEVAL_MODE=hybrid
AGENT_PORT=8000
LOG_LEVEL=INFO

# CP2 Agent runtime
MEMORY_ENABLED=true
MAX_MEMORY_MESSAGES=10
MAX_AGENT_ITERATIONS=5
MAX_REPEATED_TOOL_CALLS=2
SOURCE_INTENT_ROUTING_MODE=shadow
SOURCE_INTENT_CANARY_PERCENT=10

# OpenAI-compatible Chat Completions
# LLM_API_KEY=
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.1
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2000
# LLM_TIMEOUT=30
# Version-aware Document/Section navigation. Keep disabled until P0 evaluation passes.
AGENTIC_EXPLORATION_ENABLED=false
KNOWLEDGE_NAVIGATION_ENABLED=false
WIKI_INGEST_ENABLED=false
WIKI_PUBLISH_ENABLED=false
WIKI_VECTOR_SEARCH_ENABLED=false
EXPLORATION_MAX_ROUNDS=4
EXPLORATION_MAX_TOOL_CALLS=8
EXPLORATION_MAX_EVIDENCE=20
WIKI_DB_PATH=data-persistence/data/wiki.sqlite3
ENTERPRISE_KNOWLEDGE_BASE_ID=default
