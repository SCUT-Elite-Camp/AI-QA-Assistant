# ==========================================
# AI-QA-Assistant (Agent Layer) 配置示例
# 复制此文件为 .env 或 agent/.env
# ==========================================

# 基础服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=True
AGENT_API_KEY=

# CP2 Agent runtime
MEMORY_ENABLED=true
PERSISTENT_MEMORY_ENABLED=false
SESSION_FACT_ENABLED=false
AGENT_INTERNAL_TOKEN=
PERSONAL_LIBRARY_ENABLED=false
ATTACHMENTS_ENABLED=false
ATTACHMENT_SERVICE_URL=http://127.0.0.1:8200
ATTACHMENT_INTERNAL_SECRET=
MAX_MEMORY_MESSAGES=10
# Persistent Memory remains disabled until the staged rollout is approved.
PERSISTENT_MEMORY_ENABLED=false
# Session Fact proposal and deterministic recall stay disabled until rollout.
SESSION_FACT_ENABLED=false
# Redis/cache support is intentionally unavailable in the first rollout.
MEMORY_CACHE_ENABLED=false
# Bounded persistent-context and deterministic compaction defaults.
MEMORY_TAIL_MESSAGES=8
MEMORY_COMPACTION_MIN_MESSAGES=12
MEMORY_COMPACTION_SOFT_TOKENS=1000
# Upper bound for a persisted, incremental Snapshot summary.
MEMORY_SNAPSHOT_SUMMARY_MAX_CHARS=1200
# Required only by token-protected /api/internal/* endpoints; do not commit a real value.
AGENT_INTERNAL_TOKEN=
MAX_AGENT_ITERATIONS=5
MAX_REPEATED_TOOL_CALLS=2
# Tool caller wait budget and process-wide worker + queued-work capacity.
TOOL_TIMEOUT_MS=60000
TOOL_EXECUTOR_MAX_WORKERS=8
TOOL_EXECUTOR_MAX_PENDING=16
# Finite deadline for OpenAI-compatible embedding API requests (API provider only).
EMBEDDING_API_TIMEOUT_SECONDS=20

# English-first local retrieval. Existing doc_chunks uses 384-dimensional vectors.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_MODEL_PATH=models/bge-small-en-v1.5
LOCAL_EMBEDDING_MODEL_DIM=384
LOCAL_EMBEDDING_DEVICE=cpu

# OpenAI-compatible Chat Completions
# LLM_API_KEY=
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3.7-flash-2026-07-15
# QUERY_PREPARATION_MODEL=qwen3.7-flash-2026-07-15
# ANSWER_COMPLETENESS_MODEL=qwen3.7-flash-2026-07-15
# ANSWER_FAST_MODEL=qwen3.7-flash-2026-07-15
# Optional stage-specific model. Empty means reuse LLM_MODEL.
# QUERY_PREPARATION_MODEL=qwen3.6-flash
# Optional model for complex-answer completeness review. Empty means reuse LLM_MODEL.
# Single-target answers use a deterministic local check and do not call this model.
# ANSWER_COMPLETENESS_MODEL=qwen3.6-flash
# ANSWER_COMPLETENESS_MODEL_THINKING=false
# Optional fast final-answer model for simple intents. Empty disables routing.
# ANSWER_FAST_MODEL=qwen-flash
# ANSWER_FAST_MODEL_THINKING=false
# LLM_TEMPERATURE=0.1
# LLM_THINKING_MODE=enabled
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=2000
# LLM_TIMEOUT=30

# Volcengine Ark standard OpenAI-compatible API (pay-as-you-go model API)
# LLM_API_KEY=replace-with-your-ark-api-key
# LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=deepseek-v4-1-flash-260910
# LLM_THINKING_MODE=disabled
# Do not use /api/coding/v3 here unless the credential belongs to Ark Coding Plan.
# Version-aware Document/Section navigation. Keep disabled until P0 evaluation passes.
HIERARCHICAL_NAVIGATION_ENABLED=false

# Evidence-grounded Wiki exploration. Keep all gates disabled until the
# corresponding ingestion, retrieval, and release checks have passed.
AGENTIC_EXPLORATION_ENABLED=false
KNOWLEDGE_NAVIGATION_ENABLED=false
WIKI_INGEST_ENABLED=false
WIKI_PUBLISH_ENABLED=false
WIKI_VECTOR_SEARCH_ENABLED=false
EXPLORATION_MAX_ROUNDS=4
EXPLORATION_MAX_TOOL_CALLS=8
EXPLORATION_MAX_EVIDENCE=20
# Append up to this many versioned, unique wiki_search_evidence items after
# Direct Evidence. Set to 0 to use the legacy merge behavior.
WIKI_CONTEXT_TOP_K=3
WIKI_DB_PATH=data-persistence/data/wiki.sqlite3
ENTERPRISE_KNOWLEDGE_BASE_ID=default

# Native source ACL checks: copy/fill .source-access.env.example privately first.
SOURCE_ACCESS_MODE=native
# Use an absolute path so root and agent-directory entry points behave identically.
# CONFLUENCE_AUTH_ENV_FILE=C:/path/to/checkout/agent/.source-access.env.local
# WEB_SQLITE_PATH must identify the same database as Web TURSO_DATABASE_URL.
# RESEARCH_DOCUMENTS_DIR=C:/aiqa-acceptance/runtime/documents
# AI_QA_DATA_DIR=C:/aiqa-acceptance/runtime
# BM25_INDEX_PATH=C:/aiqa-acceptance/runtime/bm25.pkl
# RESEARCH_DATABASE_PATH=C:/aiqa-acceptance/runtime/research.db
# RESEARCH_CHECKPOINT_PATH=C:/aiqa-acceptance/runtime/research.checkpoints.db
