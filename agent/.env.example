DEFAULT_TOP_K=5
MIN_RETRIEVAL_SCORE=0.0
DEFAULT_RETRIEVAL_MODE=hybrid
AGENT_PORT=8000
LOG_LEVEL=INFO

# CP2 Agent runtime
MEMORY_ENABLED=true
MAX_MEMORY_MESSAGES=10
MAX_AGENT_ITERATIONS=5
MAX_REPEATED_TOOL_CALLS=2

# OpenAI-compatible Chat Completions
# LLM_API_KEY=
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.1
# Optional stage-specific model. Empty means reuse LLM_MODEL.
# QUERY_PREPARATION_MODEL=qwen3.6-flash
# Optional model for complex-answer completeness review. Empty means reuse LLM_MODEL.
# Single-target answers use a deterministic local check and do not call this model.
# ANSWER_COMPLETENESS_MODEL=qwen3.6-flash
# ANSWER_COMPLETENESS_MODEL_THINKING=false
# Optional fast final-answer model for simple intents. Empty disables routing.
# ANSWER_FAST_MODEL=qwen-flash
# ANSWER_FAST_MODEL_THINKING=false
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2000
# LLM_TIMEOUT=30
