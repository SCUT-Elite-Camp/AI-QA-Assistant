# ==========================================
# AI-QA-Assistant (Agent Layer) 配置示例
# 复制此文件为 .env 或 agent/.env
# ==========================================

# 基础服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ==========================================
# 选项 1: Google Gemini API (推荐，有免费额度)
# 获取地址: https://aistudio.google.com/ (点击 Get API key，免费使用)
# ==========================================
LLM_API_KEY=your_gemini_api_key_here
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
# 可选模型: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro

# ==========================================
# 选项 2: 硅基流动 SiliconFlow (国内直连、免翻墙、赠送免费额度)
# 获取地址: https://cloud.siliconflow.cn/
# ==========================================
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_API_BASE=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# 可选模型: deepseek-ai/DeepSeek-V3, deepseek-ai/DeepSeek-R1, Qwen/Qwen2.5-72B-Instruct

# ==========================================
# 选项 3: Groq (超快推理速度、每天免费额度)
# 获取地址: https://console.groq.com/
# ==========================================
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxx
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ==========================================
# 选项 4: OpenRouter (聚合众多开源及免费模型)
# 获取地址: https://openrouter.ai/
# ==========================================
# LLM_API_KEY=sk-or-v1-xxxxxxxx
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.0-flash-exp:free

# ==========================================
# 选项 5: 本地 Ollama (离线本地免费运行)
# ==========================================
# LLM_API_KEY=
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.1
