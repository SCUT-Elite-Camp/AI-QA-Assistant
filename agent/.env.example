# ==========================================
# AI-QA-Assistant (Agent Layer) 配置示例
# 复制此文件为 .env 或 agent/.env
# ==========================================

# 基础服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=True
AGENT_API_KEY=

# CP2 Agent runtime
MEMORY_ENABLED=true
PERSONAL_LIBRARY_ENABLED=false
ATTACHMENTS_ENABLED=false
# Agent hosts private file APIs. Python tools call Toolset and storage directly.
ATTACHMENT_INTERNAL_SECRET=
# Fernet urlsafe base64 32-byte key; required by Agent private file storage.
ATTACHMENT_ENCRYPTION_KEY=
# Keep this path and key when migrating from the former standalone service.
# ATTACHMENT_DATA_DIR=C:/aiqa-runtime/attachments
ATTACHMENT_VECTOR_INDEX_ENABLED=true
ATTACHMENT_MILVUS_COLLECTION=attachment_evidence_cp2
# Shared Milvus failure backoff and document vector worker timeout (seconds).
MILVUS_CONNECT_RETRY_SECONDS=30
VECTOR_PROCESS_TIMEOUT_SECONDS=120
ATTACHMENT_PARSE_TIMEOUT_SECONDS=300
MAX_MEMORY_MESSAGES=10
# Persistent Memory remains disabled until the staged rollout is approved.
PERSISTENT_MEMORY_ENABLED=false
# Redis/cache support is intentionally unavailable in the first rollout.
MEMORY_CACHE_ENABLED=false
# Bounded persistent-context and deterministic compaction defaults.
MEMORY_TAIL_MESSAGES=8
MEMORY_COMPACTION_MIN_MESSAGES=12
MEMORY_COMPACTION_SOFT_TOKENS=1000
# Upper bound for a persisted, incremental Snapshot summary.
MEMORY_SNAPSHOT_SUMMARY_MAX_CHARS=1200
# Required only by token-protected /api/internal/* endpoints; do not commit a real value.
AGENT_INTERNAL_TOKEN=
MAX_REPEATED_TOOL_CALLS=2
# Tool caller wait budget and process-wide worker + queued-work capacity.
TOOL_TIMEOUT_MS=60000
TOOL_EXECUTOR_MAX_WORKERS=8
TOOL_EXECUTOR_MAX_PENDING=16
# Finite deadline for OpenAI-compatible embedding API requests (API provider only).
EMBEDDING_API_TIMEOUT_SECONDS=20

# English-first local retrieval. Existing doc_chunks uses 384-dimensional vectors.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_MODEL_PATH=models/bge-small-en-v1.5
LOCAL_EMBEDDING_MODEL_DIM=384

# Local English cross-encoder: retrieve 20 candidates, return the requested TopK (default 5).
# Install weights separately; requests never download models. Missing weights log RERANK_DEGRADED.
RERANK_ENABLED=true
RERANK_CANDIDATE_K=20
RERANK_DEVICE=cpu
RERANK_CPU_THREADS=4
# RERANK_MODEL_PATH=C:/models/ms-marco-MiniLM-L6-v2
# CHUNK_TOKENIZER_PATH=C:/models/bge-small-en-v1.5/tokenizer.json
CHUNK_MAX_TOKENS=320
RETRIEVAL_CONTEXT_ENABLED=true
LOCAL_EMBEDDING_DEVICE=cpu

# OpenAI-compatible Chat Completions
# LLM_API_KEY=
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3.7-flash-2026-07-15
# ANSWER_FAST_MODEL=qwen3.7-flash-2026-07-15
# Enable only when the configured Fast model accepts OpenAI-compatible image inputs.
FAST_MODEL_SUPPORTS_IMAGES=false
FAST_CONTEXT_MAX_CHARS=12000
# Optional stage-specific model. Empty means reuse LLM_MODEL.
# Optional model for complex-answer completeness review. Empty means reuse LLM_MODEL.
# Single-target answers use a deterministic local check and do not call this model.
# Optional fast final-answer model for simple intents. Empty disables routing.
# ANSWER_FAST_MODEL=qwen-flash
# ANSWER_FAST_MODEL_THINKING=false
# LLM_TEMPERATURE=0.1
# LLM_THINKING_MODE=enabled
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=2000
# LLM_TIMEOUT=30

# Research completion budgets include reasoning; input/context tokens are separate.
RESEARCH_MODEL_REASONING_TOKENS=3072
RESEARCH_REVIEW_REASONING_TOKENS=3072
RESEARCH_MODEL_TIMEOUT_SECONDS=180
# Keep true normally; false reduces synthesis/staged-writing cost on providers with a native off switch.
RESEARCH_REPORT_THINKING=true
# Reviewer/final coordinator JSON decisions; false requests bounded non-reasoning controls, never bypasses review.
RESEARCH_CONTROL_THINKING=true
RESEARCH_MODEL_OUTPUT_TOKENS=2048
# Shared cap across report generation, sections, repairs and checks in one attempt.
RESEARCH_MODEL_TOTAL_TOKENS=64000
# One 429 retry, honoring Retry-After/provider delay up to this many seconds.
RESEARCH_MODEL_MAX_RETRY_WAIT_SECONDS=60

# OpenRouter: store the actual key only in ignored agent/.env.
# LLM_API_KEY=replace-with-your-openrouter-key
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# ANSWER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
# ANSWER_FAST_MODEL_THINKING=false
# LLM_THINKING_MODE=enabled
# LLM_REASONING_EFFORT=medium
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT=120
# OpenRouter receives reasoning.enabled/effort; reasoning consumes output tokens.
# Fast disables reasoning. Thinking and Research use LLM_MODEL.
# No legacy Gemini fallback models are used on OpenRouter.

# Groq GPT-OSS: Fast uses 20B with low reasoning; Thinking uses 120B/high.
# LLM_API_KEY=replace-with-your-groq-key
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# ANSWER_FAST_MODEL=openai/gpt-oss-20b
# ANSWER_FAST_MODEL_THINKING=false
# LLM_THINKING_MODE=enabled
# LLM_REASONING_EFFORT=high
# LLM_MAX_TOKENS=4096
# Groq receives reasoning_effort=low/high and max_completion_tokens.
# GPT-OSS does not support disabling reasoning. No cross-provider fallback.

# Volcengine Ark standard OpenAI-compatible API (pay-as-you-go model API)
# LLM_API_KEY=replace-with-your-ark-api-key
# LLM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=deepseek-v4-1-flash-260910
# LLM_THINKING_MODE=disabled
# Do not use /api/coding/v3 here unless the credential belongs to Ark Coding Plan.

# Evidence-grounded Wiki exploration. Keep all gates disabled until the
# corresponding ingestion, retrieval, and release checks have passed.
AGENTIC_EXPLORATION_ENABLED=false
KNOWLEDGE_NAVIGATION_ENABLED=false
WIKI_INGEST_ENABLED=false
WIKI_PUBLISH_ENABLED=false
WIKI_VECTOR_SEARCH_ENABLED=false
WIKI_DB_PATH=data-persistence/data/wiki.sqlite3
ENTERPRISE_KNOWLEDGE_BASE_ID=default

# Native source ACL checks: configure credentials in ignored agent/.env, or use
# an existing private credential file through CONFLUENCE_AUTH_ENV_FILE below.
SOURCE_ACCESS_MODE=native
# Local Research development grants all catalog files to enabled signed-in users.
# Requires HOST=127.0.0.1 (or localhost/::1); production keeps this false.
RESEARCH_DEVELOPMENT_MODE=false
# CONFLUENCE_BASE=https://your-site.atlassian.net
# CONFLUENCE_EMAIL=
# CONFLUENCE_TOKEN=
# Explicit local user -> verified native account/site bindings; never auto-grant.
# CONFLUENCE_ACCOUNT_BINDINGS={"local-user-id":{"site":"your-site.atlassian.net","account_id":"verified-native-account-id"}}
# Use an absolute path so root and agent-directory entry points behave identically.
# CONFLUENCE_AUTH_ENV_FILE=C:/path/to/checkout/agent/.source-access.env.local
# WEB_SQLITE_PATH must identify the same database as Web TURSO_DATABASE_URL.
# RESEARCH_DOCUMENTS_DIR=C:/aiqa-acceptance/runtime/documents
# AI_QA_DATA_DIR=C:/aiqa-acceptance/runtime
# BM25_INDEX_PATH=C:/aiqa-acceptance/runtime/bm25.pkl
# RESEARCH_DATABASE_PATH=C:/aiqa-acceptance/runtime/research.db
# RESEARCH_CHECKPOINT_PATH=C:/aiqa-acceptance/runtime/research.checkpoints.db

# Thinking: one bounded Agent loop. No intent classifier/rewrite/planner model.
THINKING_MAX_MODEL_CALLS=10
THINKING_MAX_TOOL_CALLS=8
THINKING_CONTEXT_MAX_CHARS=30000
THINKING_MAX_RESERVED_TOKENS=150000
THINKING_MAX_VERIFICATIONS=48
THINKING_TIMEOUT_SECONDS=180
# Local lytang/MiniCheck-DeBERTa-v3-Large weights; never downloaded by a request.
MINICHECK_MODEL_PATH=data-persistence/models/minicheck
MINICHECK_CPU_THREADS=4
