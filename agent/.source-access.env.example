# Copy to .source-access.env.local; never commit real credentials.
CONFLUENCE_BASE=https://your-site.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
# Explicit local user -> native account/site binding. No automatic service-user grant.
CONFLUENCE_ACCOUNT_BINDINGS={"accept-alice":{"site":"your-site.atlassian.net","account_id":"replace-with-confirmed-native-account-id"}}
