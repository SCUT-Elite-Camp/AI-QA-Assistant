# AI Gateway 配置
AI_GATEWAY_API_KEY=

# GitHub OAuth 认证（可选）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# Private ASR service (server-side only)
ASR_BASE_URL=http://127.0.0.1:8100
ASR_INTERNAL_SECRET=
ASR_MAX_FILE_BYTES=10485760
ASR_TIMEOUT_SECONDS=45
VOICE_RATE_LIMIT_PER_MINUTE=5

# Private attachment service (server-side only)
ATTACHMENTS_ENABLED=false
PERSONAL_LIBRARY_ENABLED=false
ATTACHMENT_SERVICE_URL=http://127.0.0.1:8200
ATTACHMENT_INTERNAL_SECRET=
ATTACHMENT_ENCRYPTION_KEY=
ATTACHMENT_SCANNER=auto
ATTACHMENT_PARSE_TIMEOUT_SECONDS=300
LOCAL_MODEL_ROOT=G:\AI-QA-Assistant\models
MODEL_CACHE_ROOT=G:\AI-QA-Assistant\cache
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PP_STRUCTURE_CONFIG_PATH=G:\AI-QA-Assistant\models\paddleocr\PP-StructureV3\pipeline.yaml
PADDLE_OCR_ENABLE_MKLDNN=false
LIBREOFFICE_PATH=
LOCAL_VISION_ENABLED=false
LOCAL_VISION_MODEL_PATH=G:\AI-QA-Assistant\models\qwen\Qwen3-VL-2B-Instruct
ATTACHMENT_VECTOR_INDEX_ENABLED=true
ATTACHMENT_MILVUS_COLLECTION=attachment_evidence_cp2
ALLOW_ANONYMOUS_UPLOAD=false

# 数据库配置（默认使用本地 SQLite，生产环境使用 Turso）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
