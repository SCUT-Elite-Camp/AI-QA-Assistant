# AI Gateway 配置
AI_GATEWAY_API_KEY=

# GitHub OAuth 认证（可选）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# Server-side Agent configuration. Keep AGENT_INTERNAL_TOKEN out of source control.
AGENT_BASE_URL=
AGENT_INTERNAL_TOKEN=
# Persistent Snapshot/Tail is opt-in and cache support is unavailable.
PERSISTENT_MEMORY_ENABLED=false
MEMORY_CACHE_ENABLED=false
# Fact proposal, confirmation and deterministic recall stay disabled until rollout.
SESSION_FACT_ENABLED=false

# 数据库配置（开发默认地址；生产环境必须显式配置 Turso URL）
TURSO_DATABASE_URL=file:.data/sqlite.db
TURSO_AUTH_TOKEN=
