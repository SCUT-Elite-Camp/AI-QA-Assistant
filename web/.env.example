# AI Gateway 配置
AI_GATEWAY_API_KEY=

# GitHub OAuth 认证（可选）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# 数据库配置（默认使用本地 SQLite，生产环境使用 Turso）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Deep Research Agent（默认连接本地 FastAPI）
VITE_RESEARCH_API_BASE=http://127.0.0.1:8000
# 前端独立开发时设为 true；最终联调必须设为 false
VITE_RESEARCH_USE_MOCK=false
